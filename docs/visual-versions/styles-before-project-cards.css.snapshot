@import "tailwindcss";
:root { --background: #fafaf9; --foreground: #212321; --muted: #626560; --line: #e4e5df; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 100px; }
body { margin: 0; background: var(--background); color: var(--foreground); font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
a:focus-visible { outline: 2px solid #356551; outline-offset: 6px; border-radius: 3px; }
::selection { background: #dde8dd; }
.container { width: min(100% - 128px, 1312px); margin-inline: auto; }
.skip-link { position: fixed; top: 12px; left: 16px; z-index: 100; transform: translateY(-180%); background: white; padding: 12px; }
.skip-link:focus { transform: none; }
.header { position: sticky; top: 0; z-index: 22; background: transparent; }
.header-inner { height: 72px; display: flex; justify-content: space-between; align-items: center; }
.wordmark { font-size: 17.6px; font-weight: 550; letter-spacing: -.025em; }
nav { display: flex; gap: 32px; }
nav a { font-size: 15.4px; min-height: 44px; display: inline-flex; align-items: center; color: #454943; transition: color .18s; }
nav a:hover { color: #121510; text-decoration: underline; text-underline-offset: 5px; }
.hero { padding-block: 86px 78px; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); align-items: center; gap: 64px; }
.hero-copy { min-width: 0; }
.hero-timeline { min-width: 0; }
.timeline-list { margin: 0; display: grid; gap: 25px; }
.timeline-list > div { display: grid; grid-template-columns: 100px minmax(0, 1fr); align-items: baseline; gap: 16px; }
.timeline-list dt { color: #606168; font-size: 13px; letter-spacing: .02em; font-variant-numeric: tabular-nums; }
.timeline-list dd { margin: 0; font-size: 15px; line-height: 1.4; text-align: right; }
.hero .availability { display: flex; align-items: center; gap: 9px; margin: 28px 0 0; font-size: 13px; letter-spacing: .025em; color: #606168; }
.availability > span { width: 9px; height: 9px; flex-shrink: 0; border-radius: 50%; background: #6bd3b0; }
.hero h1 { margin: 0; max-width: 1050px; font-size: clamp(38px, 3.25vw, 48px); font-weight: 400; line-height: 1.12; letter-spacing: -.045em; text-wrap: balance; }
.hero h1 span { font-weight: 530; }
.hero p { margin: 26px 0 0; color: var(--muted); font-size: 18px; line-height: 1.55; letter-spacing: -.015em; }
.section-label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; color: var(--muted); font-size: 13px; }
.section-label h2 { font-size: inherit; font-weight: 450; margin: 0; }
.section-label > span { font-variant-numeric: tabular-nums; font-size: 12px; letter-spacing: .07em; }
.project-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 64px 28px; }
.project-art { height: clamp(390px, 39vw, 540px); border-radius: 16px; overflow: hidden; display: grid; place-items: center; }
.trip-art { background: #eeeee7; }
.phones { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; padding: 42px 26px; }
.phone { background: #20211e; padding: 6px; border-radius: 30px; width: 40%; max-width: 210px; flex-shrink: 0; box-shadow: 0 18px 24px -16px rgb(25 29 22 / 40%), 0 2px 5px rgb(0 0 0 / 12%); }
.phone img { display: block; width: 100%; height: auto; border-radius: 24px; }
.phone-back { transform: rotate(-7deg) translateY(-8px); margin-right: -24px; }
.phone-front { transform: rotate(5deg) translateY(15px); position: relative; }
.placeholder-art { background: #f0f1ef; text-align: center; border: 1px solid #e8eae5; }
.placeholder-label { color: var(--muted); font-size: 12px; }
.placeholder-art p { margin: 12px 0 20px; font-size: clamp(28px, 3vw, 42px); font-weight: 450; letter-spacing: -.045em; }
.placeholder-note { font-size: 12px; color: var(--muted); border-top: 1px solid #d9dcd5; padding-top: 16px; }
.project-caption { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 20px; }
.project-caption h3 { margin: 0; font-size: 17px; font-weight: 500; letter-spacing: -.015em; }
.project-caption span { color: var(--muted); font-size: 12px; white-space: nowrap; }
.project-description { font-size: 14px; color: var(--muted); margin: 7px 0 0; line-height: 1.5; }
.next-project { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 20px; }
.about { margin-top: 130px; border-top: 1px solid var(--line); padding-top: 48px; display: grid; grid-template-columns: 1fr 2fr; gap: 40px; }
.about h2 { font-size: 18px; font-weight: 500; margin: 0; }
.about p { max-width: 650px; font-size: 24px; letter-spacing: -.025em; line-height: 1.5; margin: 0; }
.contact { padding-block: 120px; max-width: 650px; }
.contact h2 { font-size: 40px; line-height: 1.15; font-weight: 400; letter-spacing: -.04em; margin: 0 0 20px; }
.contact p { font-size: 18px; line-height: 1.6; color: var(--muted); }
.footer { padding-block: 28px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); }
@media (max-width: 1000px) { .container { width: calc(100% - 64px); } .hero { padding-block: 64px; grid-template-columns: 1fr; gap: 40px; } .hero-timeline { max-width: 480px; } .desktop-break { display: none; } .hero h1 { max-width: 760px; } .phone { border-radius: 23px; padding: 5px; } .phone img { border-radius: 18px; } }
@media (max-width: 700px) { .container { width: calc(100% - 40px); } .header-inner { height: 72px; gap: 14px; } .wordmark { font-size: 15.4px; } nav { gap: 15px; } nav a { font-size: 13.2px; } .hero { padding-block: 54px 56px; gap: 36px; } .timeline-list > div { grid-template-columns: 85px minmax(0, 1fr); gap: 12px; } .timeline-list dd { font-size: 13px; } .timeline-list dt { font-size: 12px; } .hero .availability { font-size: 12px; } .hero h1 { font-size: clamp(34px, 8.8vw, 48px); line-height: 1.15; text-wrap: auto; } .hero p { font-size: 17px; margin-top: 24px; } .project-grid { grid-template-columns: 1fr; gap: 42px; } .project-art { height: clamp(350px, 108vw, 510px); border-radius: 12px; } .phones { padding-inline: 10px; } .phone { width: 43%; } .section-label { margin-bottom: 20px; } .about { margin-top: 76px; grid-template-columns: 1fr; gap: 22px; } .about p { font-size: 21px; } .contact { padding-block: 80px; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; animation: none !important; } }

/* Identity hero: one complete viewport, with a live particle portrait. */
.hero { position: relative; display: block; isolation: auto; min-height: 680px; height: calc(100svh - 72px); padding: 0; }
.hero-intro { position: absolute; inset: 38px 0 auto; display: flex; justify-content: space-between; z-index: 3; pointer-events: none; }
.hero-intro p { margin: 0; font-size: 16px; line-height: 1.45; color: var(--foreground); }
.hero-intro p:last-child { text-align: right; }
.hero h1.hero-name { position: absolute; left: 0; right: 0; top: 46%; max-width: none; margin: 0; font-size: clamp(80px, 13.2vw, 190px); letter-spacing: -.07em; line-height: .95; font-weight: 500; white-space: nowrap; text-align: center; }
.hero-name span { color: #6b8876; }
.portrait-stage { position: absolute; z-index: 2; width: min(52%, 610px); height: 93%; bottom: 38px; left: 50%; margin-left: 0; translate: none; transform: none; left: calc(50% - min(26%, 305px)); }
.portrait-stage canvas { width: 100%; height: 100%; display: block; touch-action: pan-y; }
.portrait-error { text-align: center; }
.hero-bottom { position: absolute; bottom: 30px; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; z-index: 3; font-size: 12px; color: var(--muted); }
.hero-bottom a { display: inline-flex; align-items: center; gap: 20px; min-height: 44px; }
.hero-bottom a span { font-size: 22px; }
#proyectos { padding-top: 44px; }
.about .hero-timeline { grid-column: 2; max-width: 480px; }
.hero-timeline .availability { font-size: 13px; display: flex; align-items: center; gap: 9px; margin-top: 28px; }
@media (max-width: 700px) {
  .hero { height: calc(100svh - 72px); min-height: 610px; padding: 0; }
  .hero-intro { top: 24px; }
  .hero-intro p { font-size: 13px; }
  .hero h1.hero-name { top: 17%; font-size: 15vw; }
  .portrait-stage { width: 100%; height: 80%; bottom: 40px; }
  .hero-bottom { bottom: 18px; font-size: 11px; }
  .hero-bottom a { gap: 10px; }
  .about .hero-timeline { grid-column: 1; }
}

.wordmark-slot { visibility: hidden; }
.header { opacity: 1; }
.hero h1.scroll-name { position: fixed; z-index: 30; top: 0; left: 0; width: max-content; max-width: none; margin: 0; font-size: clamp(80px, 15.3vw, 220px); font-weight: 500; letter-spacing: -.07em; line-height: .95; white-space: nowrap; transform-origin: top left; will-change: transform; }
.scroll-name span { color: #6b8876; }
@media (max-width: 700px) { .hero h1.scroll-name { font-size: 15vw; } }

/* The portrait particles travel in viewport space into the navigation. */
.portrait-stage { z-index: auto; pointer-events: none; }
.portrait-stage canvas { position: fixed; inset: 0; width: 100vw; height: 100dvh; z-index: 21; pointer-events: none; }

@media (max-width: 700px) { .portrait-stage { left: 0; } }

/* A full-width veil fades into the page without a rectangular lower edge. */

.header nav a, .scroll-name a { transition: transform 220ms cubic-bezier(.2,.7,.2,1), color 180ms ease; transform-origin: center; }
.scroll-name a { display: inline-block; transform-origin: left center; }
.header nav a:focus-visible, .scroll-name a:focus-visible { transform: scale(1.045); }
@media (hover: hover) { .header nav a:hover, .scroll-name a:hover { transform: scale(1.045); text-decoration: none; color: #121510; } }
.header nav a:active, .scroll-name a:active { transform: scale(1.025); }
@media (prefers-reduced-motion: reduce) { .header nav a, .scroll-name a { transition: none; } }

.particle-toggle { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); z-index: 31; pointer-events: auto; padding: 10px 14px; font: inherit; font-size: 11px; color: var(--muted); border: 0; background: transparent; cursor: pointer; }
.particle-toggle:hover { color: var(--foreground); }
.particle-toggle:focus-visible { outline: 2px solid #356551; outline-offset: 2px; border-radius: 4px; }
@media (prefers-reduced-motion: reduce) { .particle-toggle { display: none; } }
